parameters:
	ignoreErrors:
		-
			message: '#^Cannot access offset ''done'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 2
			path: src/DbalRepository.php

		-
			message: '#^Cannot access offset ''id'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 2
			path: src/DbalRepository.php

		-
			message: '#^Cannot access offset ''sagaId'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/DbalRepository.php

		-
			message: '#^Parameter \#2 \$data of method Doctrine\\DBAL\\Connection\:\:insert\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: src/DbalRepository.php

		-
			message: '#^Parameter \#2 \$data of method Doctrine\\DBAL\\Connection\:\:update\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: src/DbalRepository.php
